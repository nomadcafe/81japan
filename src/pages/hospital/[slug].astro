---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { loadHospitals, hospitalSlug, type Hospital } from '../../lib/hospitals.js';
import { localizePath } from '../../lib/i18n';
import { regionByKey } from '../../lib/regions';
import { langCodes, langTokensOf, medicalType, splitPostal } from '../../lib/hospitalSeo';
import '../../styles/page.css';
import '../../styles/hospital.css';

export async function getStaticPaths() {
  const data = await loadHospitals();
  return data.map((h) => ({
    params: { slug: hospitalSlug(h) },
    props: { hospital: h },
  }));
}

const { hospital: h } = Astro.props as { hospital: Hospital };
const slug = hospitalSlug(h);
const url = `https://www.81japan.com/hospital/${encodeURIComponent(slug)}`;

const telDigits = (h.phone || '').replace(/[^\d+]/g, '');
const hasPhone = telDigits.length >= 9;

const mapAddr = h.address || h.addressShort;
const mapHref = mapAddr
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(h.name + ' ' + mapAddr)}`
  : null;

const updatedFmt = (() => {
  const m = (h.updated || '').match(/^(\d{4})-(\d{1,2})$/);
  return m ? `${m[1]}年${parseInt(m[2], 10)}月` : (h.updated || '');
})();

const langSet = new Set(h.langs || []);
const isCN = langSet.has('中文');
const isEN = langSet.has('英文');

const langTokens = langTokensOf(h);
const availableLanguage = langCodes(h);

// 地区落地页链接（用于面包屑内链）
const regionMeta = h.region ? regionByKey(h.region) : undefined;
const regionHref = regionMeta ? localizePath(`/${regionMeta.slug}`, 'zh') : null;
const regionUrl = regionMeta ? `https://www.81japan.com${regionHref}` : null;

const description = `${h.name}（${h.jpName || ''}）位于${h.region || '日本'}${h.addressShort ? '・' + h.addressShort : ''}。${
  isCN ? '提供中文医疗服务，' : ''
}${(h.depts && h.depts.length) ? '科室包括' + h.depts.slice(0, 4).join('、') + '等。' : ''}${
  h.phone ? '电话：' + h.phone + '。' : ''
}`.slice(0, 160);

const { postalCode, streetAddress } = splitPostal(h.address);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': medicalType(h),
      '@id': url + '#organization',
      'name': h.name,
      ...(h.jpName ? { 'alternateName': h.jpName } : {}),
      'url': url,
      ...(h.phone ? { 'telephone': h.phone } : {}),
      ...(mapAddr ? {
        'address': {
          '@type': 'PostalAddress',
          'streetAddress': streetAddress || h.address || h.addressShort,
          ...(postalCode ? { 'postalCode': postalCode } : {}),
          'addressRegion': h.region,
          'addressCountry': 'JP',
        },
      } : {}),
      ...(mapHref ? { 'hasMap': mapHref } : {}),
      ...(h.region ? { 'areaServed': h.region } : {}),
      ...(h.depts && h.depts.length ? { 'medicalSpecialty': h.depts } : {}),
      ...(availableLanguage.length ? { 'availableLanguage': availableLanguage, 'knowsLanguage': availableLanguage } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': '医院诊所', 'item': 'https://www.81japan.com/' },
        ...(regionUrl ? [{ '@type': 'ListItem', 'position': 2, 'name': h.region, 'item': regionUrl }] : []),
        { '@type': 'ListItem', 'position': regionUrl ? 3 : 2, 'name': h.name },
      ],
    },
  ],
};
---
<Layout
  title={`${h.name}${h.jpName && h.jpName !== h.name ? '（' + h.jpName + '）' : ''} · ${h.region || '日本'}中文医院 | 81日本`}
  description={description}
  path={`/hospital/${slug}`}
  locale="zh"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <Nav active="hospitals" locale="zh" />

  <nav class="breadcrumb" aria-label="面包屑">
    <a href="/">医院诊所</a>
    {h.region && <span class="bc-sep">/</span>}
    {h.region && (regionHref ? <a href={regionHref}>{h.region}</a> : <span class="bc-current">{h.region}</span>)}
    <span class="bc-sep">/</span>
    <span class="bc-current">{h.name}</span>
  </nav>

  <article class="h-detail">
    <header class="h-header">
      <div class="h-eyebrow">
        {h.region && <span class="h-region">{h.region}</span>}
        <div class="h-badges">
          {isCN && <span class="badge badge-cn">中文</span>}
          {isEN && <span class="badge badge-en">英文</span>}
          {(h.extraBadges || []).map((b) => <span class="badge badge-new">{b.label}</span>)}
        </div>
      </div>
      <h1 class="h-name">{h.name}</h1>
      {h.jpName && h.jpName !== h.name && <p class="h-name-ja">{h.jpName}</p>}

      <div class="h-cta">
        {hasPhone && (
          <a class="h-cta-btn h-cta-primary" href={`tel:${telDigits}`}>
            <span aria-hidden="true">📞</span>
            <span>拨打电话</span>
          </a>
        )}
        {mapHref && (
          <a class="h-cta-btn" href={mapHref} target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">🗺</span>
            <span>在 Google 地图查看</span>
          </a>
        )}
      </div>
    </header>

    <section class="h-section">
      <h2 class="h-section-title">基本信息</h2>
      <dl class="h-info-grid">
        {(h.address || h.addressShort) && (
          <div class="h-info-item">
            <dt>地址</dt>
            <dd>{h.address || h.addressShort}</dd>
          </div>
        )}
        {h.phone && (
          <div class="h-info-item">
            <dt>电话</dt>
            <dd>{hasPhone ? <a href={`tel:${telDigits}`}>{h.phone}</a> : h.phone}</dd>
          </div>
        )}
        {(h.hours || h.hoursShort) && (
          <div class="h-info-item">
            <dt>营业时间</dt>
            <dd>{h.hours || h.hoursShort}</dd>
          </div>
        )}
        {h.closed && (
          <div class="h-info-item">
            <dt>休诊日</dt>
            <dd>{h.closed}</dd>
          </div>
        )}
      </dl>
    </section>

    {langTokens.length > 0 && (
      <section class="h-section">
        <h2 class="h-section-title">服务语言</h2>
        {h.langDetail && <p class="h-lang-detail">{h.langDetail}</p>}
      </section>
    )}

    {h.depts && h.depts.length > 0 && (
      <section class="h-section">
        <h2 class="h-section-title">提供科室</h2>
        <div class="h-dept-list">
          {h.depts.map((d) => <span class="dept-tag">{d}</span>)}
        </div>
      </section>
    )}

    {h.note && (
      <section class="h-section">
        <h2 class="h-section-title">注意事项</h2>
        <p class="h-note">{h.note}</p>
      </section>
    )}

    {h.warning && (
      <section class="h-section">
        <div class="h-warning">⚠️ {h.warning}</div>
      </section>
    )}

    <footer class="h-meta">
      <span>最近更新：{updatedFmt}</span>
      <a class="h-back" href="/">← 返回列表</a>
    </footer>
  </article>

  <Footer locale="zh" />

  <script is:inline src="/page.js" defer></script>
</Layout>
